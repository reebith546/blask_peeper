# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не коммитится в git.

SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=blackpepper
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Платёжный шлюз TipTop Pay (https://developers.tiptoppay.kz)
# Реквизиты можно задать здесь ИЛИ в админке: Платежи -> «Настройки онлайн-оплаты»
# (только для владельца). Запись в админке имеет приоритет над этими значениями;
# .env остаётся как запасной вариант. Пока ни там, ни там ничего нет — онлайн-оплата
# выключена, чекаут работает по-старому.
# У TipTop Pay всего два реквизита: Public ID (pk_…) и API Secret.
TIPTOP_API_BASE=https://api.tiptoppay.kz
TIPTOP_PUBLIC_ID=
TIPTOP_API_SECRET=
PAYMENT_CURRENCY=KZT
# В личном кабинете TipTop Pay для webhook укажите (по одному адресу на событие):
#   https://<домен>/payments/callback/?type=pay
#   https://<домен>/payments/callback/?type=fail
#   https://<домен>/payments/callback/?type=refund
# и схему аутентификации уведомлений — HMAC.

# Яндекс Карты — автоподсказки адреса (Геосаджест) и координаты (Геокодер) на чекауте
YANDEX_SUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=

# Только для продакшена (DEBUG=False) — см. deploy/DEPLOY.md
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://blackpepperflowerbar.kz,https://www.blackpepperflowerbar.kz
