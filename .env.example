# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не коммитится в git.

SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=blackpepper
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Платёжный шлюз TipTop Pay / SmartCore (https://docs.smartcore.pro)
# Пока пусто — онлайн-оплата выключена, чекаут работает по-старому.
# Как только заполнены ACCOUNT + MERCHANT_KEY + SECRET — оплата включается.
SMARTCORE_API_BASE=https://api-gateway.smartcore.pro
SMARTCORE_ACCOUNT=
SMARTCORE_MERCHANT_KEY=
SMARTCORE_SECRET=
PAYMENT_CURRENCY=KZT
# В личном кабинете шлюза для callback укажите: https://<домен>/payments/callback/

# Яндекс Карты — автоподсказки адреса (Геосаджест) и координаты (Геокодер) на чекауте
YANDEX_SUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=

# Только для продакшена (DEBUG=False) — см. deploy/DEPLOY.md
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://blackpepperflowerbar.kz,https://www.blackpepperflowerbar.kz
