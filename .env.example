# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не коммитится в git.

SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=blackpepper
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# TipTop Pay (https://developers.tiptoppay.kz)
# Заполняются перед подключением приёма платежей — не коммитить реальные значения.
TIPTOP_PUBLIC_ID=
TIPTOP_API_SECRET=

# Яндекс Карты — автоподсказки адреса (Геосаджест) и координаты (Геокодер) на чекауте
YANDEX_SUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=
